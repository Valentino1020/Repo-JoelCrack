
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Página Web</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #101827;
            color: white;
        }

        header {
            background: #080e19;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            color: #38bdf8;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 15px;
        }

        nav a:hover {
            color: #38bdf8;
        }

        .principal {
            min-height: 75vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 30px;
            background: linear-gradient(135deg, #101827, #164e63);
        }

        .principal h2 {
            font-size: 48px;
            margin-bottom: 20px;
        }

        .principal p {
            font-size: 18px;
            color: #cbd5e1;
            margin-bottom: 30px;
        }

        button {
            background: #38bdf8;
            color: #082f49;
            border: none;
            padding: 14px 25px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #7dd3fc;
            transform: scale(1.05);
        }

        .contenido {
            padding: 50px 20px;
            text-align: center;
        }

        .tarjetas {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 30px;
        }

        .tarjeta {
            background: #1e293b;
            padding: 30px;
            border-radius: 12px;
            width: 250px;
            border: 1px solid #334155;
        }

        .tarjeta h3 {
            color: #38bdf8;
            margin-bottom: 15px;
        }

        footer {
            text-align: center;
            background: #080e19;
            padding: 20px;
            color: #94a3b8;
        }

        @media (max-width: 600px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            .principal h2 {
                font-size: 34px;
            }

            nav a {
                margin: 5px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>MiWeb</h1>

        <nav>
            <a href="#inicio">Inicio</a>
            <a href="#servicios">Servicios</a>
            <a href="#contacto">Contacto</a>
        </nav>
    </header>

    <section class="principal" id="inicio">
        <h2>¡Bienvenido a mi web!</h2>

        <p>Esta es mi primera página web creada con código.</p>

        <button onclick="mostrarMensaje()">
            ¡Hacé clic acá!
        </button>
    </section>

    <section class="contenido" id="servicios">
        <h2>¿Qué encontrarás?</h2>

        <div class="tarjetas">
            <div class="tarjeta">
                <h3>🚀 Innovación</h3>
                <p>Ideas nuevas y proyectos increíbles.</p>
            </div>

            <div class="tarjeta">
                <h3>💻 Tecnología</h3>
                <p>Un espacio para aprender y crear.</p>
            </div>

            <div class="tarjeta">
                <h3>🎮 Diversión</h3>
                <p>Experiencias interactivas para explorar.</p>
            </div>
        </div>
    </section>

    <section class="contenido" id="contacto">
        <h2>Contacto</h2>
        <p>¡Gracias por visitar mi página!</p>
    </section>

    <footer>
        <p>© 2026 MiWeb - Creado por mí</p>
    </footer>

    <script>
        function mostrarMensaje() {
            alert("¡Hola! 🎉 Gracias por visitar mi página web.");
        }
    </script>

</body>
</html>
